# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres (free tier)
DATABASE_URL=

# iron-session cookie encryption. Must be >= 32 characters.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# MeWe app credentials. SERVER-ONLY — these must never reach the browser.
MEWE_APP_ID=
MEWE_API_KEY=

# postMessage origin allowlist. Exact origin, no trailing slash.
MEWE_ORIGIN=https://mewe.com
NEXT_PUBLIC_MEWE_ORIGIN=https://mewe.com

# LiveKit Cloud (free tier). Key and secret are SERVER-ONLY.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=
